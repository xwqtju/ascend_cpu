/**
 * AscendC GMM (Grouped MatMul)
 * 每 group 独立 MatMul，手写 kernel，可在 PEM/CAMODEL 仿真
 * groups=2, each: M=4, K=8, N=4
 */
#include <cstdint>
#include <iostream>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "kernel_tiling/kernel_tiling.h"
#include "data_utils.h"

struct GmmTiling {
    int32_t groups;
    int32_t M;   // per group
    int32_t K;
    int32_t N;
    int32_t singleCoreM;
    int32_t singleCoreN;
    int32_t usedCoreNum;
};

__aicore__ inline void CopyTiling(GmmTiling *t, GM_ADDR gm) {
    auto src = reinterpret_cast<__gm__ int32_t *>(gm);
    int32_t *dst = reinterpret_cast<int32_t *>(t);
    for (uint32_t i = 0; i < sizeof(GmmTiling) / sizeof(int32_t); i++)
        dst[i] = src[i];
}

__global__ __aicore__ void gmm_kernel(GM_ADDR allX, GM_ADDR allW, GM_ADDR allY,
                                       __kfc_workspace__ GM_ADDR ws, GM_ADDR tilingGM) {
    GmmTiling t;
    CopyTiling(&t, tilingGM);

    using A_T = half; using B_T = half; using C_T = float;
    AscendC::TPipe pipe;

    // Group0 的数据偏移
    AscendC::GlobalTensor<A_T> a0, b0;
    AscendC::GlobalTensor<C_T> c0;
    {
        // Group0
        a0.SetGlobalBuffer(reinterpret_cast<__gm__ A_T *>(allX), t.M * t.K);
        b0.SetGlobalBuffer(reinterpret_cast<__gm__ B_T *>(allW), t.K * t.N);
        c0.SetGlobalBuffer(reinterpret_cast<__gm__ C_T *>(allY), t.M * t.N);

        TCubeTiling mt0; mt0.usedCoreNum=1; mt0.M=t.M; mt0.N=t.N; mt0.Ka=t.K; mt0.Kb=t.K;
        mt0.singleCoreM=t.singleCoreM; mt0.singleCoreN=t.singleCoreN;

        matmul::Matmul<matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, A_T>,
                       matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, B_T>,
                       matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, C_T>> mm0;
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm0, &mt0);
        mm0.SetOrgShape(t.M, t.N, t.K, t.K);
        mm0.SetTensorA(a0, false);
        mm0.SetTensorB(b0, false);
        mm0.IterateAll(c0);
        mm0.End();
    }

    if (t.groups > 1) {
        int64_t off = t.M * t.K;
        // Group1
        AscendC::GlobalTensor<A_T> a1, b1;
        AscendC::GlobalTensor<C_T> c1;
        a1.SetGlobalBuffer(reinterpret_cast<__gm__ A_T *>(allX) + off, t.M * t.K);
        b1.SetGlobalBuffer(reinterpret_cast<__gm__ B_T *>(allW) + off, t.K * t.N);
        c1.SetGlobalBuffer(reinterpret_cast<__gm__ C_T *>(allY) + t.M * t.N, t.M * t.N);

        TCubeTiling mt1; mt1.usedCoreNum=1; mt1.M=t.M; mt1.N=t.N; mt1.Ka=t.K; mt1.Kb=t.K;
        mt1.singleCoreM=t.singleCoreM; mt1.singleCoreN=t.singleCoreN;

        matmul::Matmul<matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, A_T>,
                       matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, B_T>,
                       matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, C_T>> mm1;
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm1, &mt1);
        mm1.SetOrgShape(t.M, t.N, t.K, t.K);
        mm1.SetTensorA(a1, false);
        mm1.SetTensorB(b1, false);
        mm1.IterateAll(c1);
        mm1.End();
    }
}

void GenerateTiling(const char *socVersion, uint8_t *tilingBuf) {
    GmmTiling t;
    t.groups = 1;  // 先跑通 1 group
    t.M = 4; t.K = 8; t.N = 4;
    t.singleCoreM = 4;
    t.singleCoreN = 4;
    t.usedCoreNum = 1;

    auto *p = platform_ascendc::PlatformAscendCManager::GetInstance(socVersion);
    uint64_t lms;
    p->GetCoreMemSize(platform_ascendc::CoreMemType::UB, lms);

    memcpy(tilingBuf, &t, sizeof(t));
    memcpy(tilingBuf + sizeof(t), &lms, sizeof(lms));
}

int32_t main(int32_t argc, char *argv[]) {
    const char *socVersion = "Ascend910B2";
    constexpr int32_t groups = 2, M = 4, K = 8, N = 4;

    auto p = platform_ascendc::PlatformAscendCManager::GetInstance(socVersion);
    size_t xSize = groups * M * K * sizeof(uint16_t);
    size_t wSize = groups * K * N * sizeof(uint16_t);
    size_t ySize = groups * M * N * sizeof(float);
    size_t wsSize = p->GetLibApiWorkSpaceSize() * groups;
    size_t tilingSize = sizeof(GmmTiling) + sizeof(uint64_t);

    uint8_t tilingBuf[tilingSize];
    GenerateTiling(socVersion, tilingBuf);

    aclInit(nullptr); aclrtSetDevice(0);
    aclrtStream stream; aclrtCreateStream(&stream);

    // 分配 + 读数据
    uint8_t *xH, *wH, *xD, *wD, *yD, *wsD, *tH, *tD;
    float *yH;
    aclrtMallocHost((void**)&xH, xSize); aclrtMalloc((void**)&xD, xSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&wH, wSize); aclrtMalloc((void**)&wD, wSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&yH, ySize); aclrtMalloc((void**)&yD, ySize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&wsD, wsSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&tH, tilingSize); aclrtMalloc((void**)&tD, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/x_gm.bin", xSize, xH, xSize);
    ReadFile("./input/w_gm.bin", wSize, wH, wSize);
    aclrtMemcpy(xD, xSize, xH, xSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wD, wSize, wH, wSize, ACL_MEMCPY_HOST_TO_DEVICE);
    memcpy(tH, tilingBuf, tilingSize);
    aclrtMemcpy(tD, tilingSize, tH, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    gmm_kernel<<<1, nullptr, stream>>>(xD, wD, yD, wsD, tD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(yH, ySize, yD, ySize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/y_gm.bin", yH, ySize);

    printf("GMM %d groups, each %dx%d * %dx%d\n", groups, M, K, K, N);
    printf("Output sample: ");
    for (int i = 0; i < 8; i++) printf("%.1f ", yH[i]);
    printf("\n");

    aclrtFree(xD); aclrtFreeHost(xH); aclrtFree(wD); aclrtFreeHost(wH);
    aclrtFree(yD); aclrtFreeHost(yH); aclrtFree(wsD); aclrtFree(tD); aclrtFreeHost(tH);
    aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
    return 0;
}
