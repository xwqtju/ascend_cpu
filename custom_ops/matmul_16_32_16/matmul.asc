/**
 * 最小 MatMul: M=16 K=32 N=16 — 验证 CAMODEL Ascend950
 */
#include <cstdint>
#include <iostream>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "kernel_tiling/kernel_tiling.h"
#include "data_utils.h"

__aicore__ inline uint32_t Ceil(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

__aicore__ inline void CopyTiling(TCubeTiling *tiling, uint64_t &localMemSize, GM_ADDR tilingGM) {
    uint32_t *ptr = reinterpret_cast<uint32_t *>(tiling);
    auto tiling32 = reinterpret_cast<__gm__ uint32_t *>(tilingGM);
    for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); i++, ptr++)
        *ptr = *(tiling32 + i);
    localMemSize = *reinterpret_cast<__gm__ uint64_t *>(tilingGM + sizeof(TCubeTiling));
}

__aicore__ inline void CalcGMOffset(int blockIdx, const TCubeTiling &tiling, int &offsetA, int &offsetB,
                                    int &offsetC, int &tailM, int &tailN, bool isTransA, bool isTransB) {
    uint32_t mSingleBlocks = Ceil(tiling.M, tiling.singleCoreM);
    uint32_t mCoreIndx = blockIdx % mSingleBlocks;
    uint32_t nCoreIndx = blockIdx / mSingleBlocks;
    offsetA = mCoreIndx * tiling.Ka * tiling.singleCoreM;
    offsetB = nCoreIndx * tiling.singleCoreN;
    offsetC = mCoreIndx * tiling.N * tiling.singleCoreM + nCoreIndx * tiling.singleCoreN;
    tailM = tiling.M - mCoreIndx * tiling.singleCoreM;
    tailM = tailM < tiling.singleCoreM ? tailM : tiling.singleCoreM;
    tailN = tiling.N - nCoreIndx * tiling.singleCoreN;
    tailN = tailN < tiling.singleCoreN ? tailN : tiling.singleCoreN;
}

__global__ __aicore__ void matmul_custom(GM_ADDR a, GM_ADDR b, GM_ADDR c, __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm) {
    AscendC::TPipe pipe;
    TCubeTiling tiling; uint64_t localMemSize = 0;
    CopyTiling(&tiling, localMemSize, tilingGm);

    AscendC::GlobalTensor<half> aGlobal, bGlobal;
    AscendC::GlobalTensor<float> cGlobal;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Ka * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c), tiling.M * tiling.N);

    int oA=0,oB=0,oC=0,tM=0,tN=0;
    CalcGMOffset(matmul::GetBlockIdx(), tiling, oA,oB,oC, tM,tN, false, false);

    matmul::Matmul<matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
                   matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
                   matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    if (matmul::GetBlockIdx() >= tiling.usedCoreNum) return;
    mm.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    mm.SetTensorA(aGlobal[oA], false);
    mm.SetTensorB(bGlobal[oB], false);
    mm.SetTail(tM, tN);
    mm.IterateAll(cGlobal[oC]);
    mm.End();
}

void GenerateTiling(const char *socVersion, uint8_t *tilingBuf) {
    constexpr int32_t M=128,N=256,K=128;
    optiling::TCubeTiling tilingData;
    auto p = platform_ascendc::PlatformAscendCManager::GetInstance(socVersion);
    matmul_tiling::MultiCoreMatmulTiling api(*p);
    api.SetDim(8);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    api.SetOrgShape(M,N,K); api.SetShape(M,N,K); api.SetBias(false);
    api.SetBufferSpace(-1,-1,-1);
    api.GetTiling(tilingData);
    tilingData.SaveToBuffer(tilingBuf, tilingData.GetDataSize());
    uint64_t lms; p->GetCoreMemSize(platform_ascendc::CoreMemType::UB, lms);
    *reinterpret_cast<uint64_t*>(tilingBuf + tilingData.GetDataSize()) = lms;
}

int32_t main(int32_t argc, char *argv[]) {
    const char *socVersion = "Ascend950PR_9599";
    constexpr int32_t M=128,N=256,K=128;

    auto p = platform_ascendc::PlatformAscendCManager::GetInstance(socVersion);
    size_t aSize = M*K*sizeof(uint16_t), bSize = K*N*sizeof(uint16_t), cSize = M*N*sizeof(float);
    size_t wsSize = p->GetLibApiWorkSpaceSize();
    size_t tilingSize = sizeof(TCubeTiling) + sizeof(uint64_t);

    uint8_t *tilingBuf = (uint8_t*)malloc(tilingSize);
    GenerateTiling(socVersion, tilingBuf);

    aclInit(nullptr); aclrtSetDevice(0);
    aclrtStream stream; aclrtCreateStream(&stream);

    uint8_t *aH,*bH,*cH,*aD,*bD,*cD,*wsD,*tH,*tD;
    aclrtMallocHost((void**)&aH,aSize); aclrtMalloc((void**)&aD,aSize,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&bH,bSize); aclrtMalloc((void**)&bD,bSize,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&cH,cSize); aclrtMalloc((void**)&cD,cSize,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&wsD,wsSize,ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)&tH,tilingSize); aclrtMalloc((void**)&tD,tilingSize,ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/x1_gm.bin", aSize, aH, aSize); aclrtMemcpy(aD,aSize,aH,aSize,ACL_MEMCPY_HOST_TO_DEVICE);
    ReadFile("./input/x2_gm.bin", bSize, bH, bSize); aclrtMemcpy(bD,bSize,bH,bSize,ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(tH,tilingSize,tilingBuf,tilingSize,ACL_MEMCPY_HOST_TO_HOST);
    aclrtMemcpy(tD,tilingSize,tH,tilingSize,ACL_MEMCPY_HOST_TO_DEVICE);

    matmul_custom<<<1, nullptr, stream>>>(aD,bD,cD,wsD,tD);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(cH,cSize,cD,cSize,ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cH, cSize);

    aclrtFree(aD);aclrtFreeHost(aH);aclrtFree(bD);aclrtFreeHost(bH);
    aclrtFree(cD);aclrtFreeHost(cH);aclrtFree(wsD);aclrtFree(tD);aclrtFreeHost(tH);
    aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
    free(tilingBuf);
    return 0;
}
