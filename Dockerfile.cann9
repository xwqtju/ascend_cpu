# =============================================================================
# CANN 9.0.0 开发镜像
# 基于官方 ascendai/cann 9.0.0，补充开发工具
# =============================================================================
ARG BASE_IMAGE=ascendai/cann:9.0.0-910-ubuntu22.04-py3.11

FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# 补充开发工具（官方镜像可能缺的）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb \
    vim \
    less \
    tree \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 升级 pip 并安装常用 Python 包
RUN pip3 install --no-cache-dir \
    numpy \
    sympy \
    scipy \
    pyyaml \
    protobuf==3.20.0 \
    decorator \
    absl-py

# 确保环境变量
RUN printf '%s\n' \
    'if [ -f /usr/local/Ascend/ascend-toolkit/set_env.sh ]; then source /usr/local/Ascend/ascend-toolkit/set_env.sh; fi' \
    'if [ -f /usr/local/Ascend/cann/set_env.sh ]; then source /usr/local/Ascend/cann/set_env.sh; fi' \
    > /etc/profile.d/ascend.sh

WORKDIR /workspace

CMD ["/bin/bash", "-l"]
